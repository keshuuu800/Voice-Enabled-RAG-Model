# ── Sarvam AI (Speech-to-Text) ─────────────────────────────────────────────────
SARVAM_API_KEY=your_sarvam_api_key_here

# ── LLM Provider ───────────────────────────────────────────────────────────────
# Options: "openrouter", "openai", or "gemini"
LLM_PROVIDER=openrouter

# OpenRouter API Key (or set LLM_API_KEY)
OPENROUTER_API_KEY=your_openrouter_api_key_here
LLM_API_KEY=your_openrouter_api_key_here

# ── LLM Models ─────────────────────────────────────────────────────────────────
# OpenRouter model: use "openrouter/free" for automatic free model routing
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash

# ── Embedding Model ────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=2000
CHUNK_OVERLAP=300

# ── Retrieval ──────────────────────────────────────────────────────────────────
SEMANTIC_TOP_K=10
BM25_TOP_K=10
FINAL_TOP_K=5
RRF_K=60

# Minimum RRF score to return an answer
MIN_RELEVANCE_SCORE=0.005

# ── Storage Paths ──────────────────────────────────────────────────────────────
CHROMA_PATH=./storage/chroma
BM25_PATH=./storage/bm25
CHROMA_COLLECTION_NAME=documents

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
